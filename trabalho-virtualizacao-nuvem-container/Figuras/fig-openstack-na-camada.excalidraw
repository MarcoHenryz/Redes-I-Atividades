      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "que são o hipervisor e o runtime de contêiner. Quem executa continua sendo a camada de baixo.",
      "originalText": "que são o hipervisor e o runtime de contêiner. Quem executa continua sendo a camada de baixo.",
