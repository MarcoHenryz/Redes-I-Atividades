      "updated": 1,
      "link": null,
      "locked": false,
      "text": "O OpenStack não executa máquina virtual nem contêiner. Ele decide, coordena e aciona os mecanismos de abstração,",
      "originalText": "O OpenStack não executa máquina virtual nem contêiner. Ele decide, coordena e aciona os mecanismos de abstração,",
      "fontSize": 12.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 11
    },
